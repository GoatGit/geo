{
  "name": "@geo/worker-web",
  "version": "0.1.0",
  "description": "网页端采集 Worker:BullMQ 消费/调度/熔断/账号池/即时抽取/进度推送(docs/04、docs/07)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "seed:profiles": "tsx src/seed.ts",
    "seed:mock": "tsx src/seed-mock.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "doubao-live": "tsx scripts/doubao-live.ts"
  },
  "dependencies": {
    "@geo/browser-session": "workspace:*",
    "@geo/db": "workspace:*",
    "@geo/engine-adapters": "workspace:*",
    "@geo/evidence": "workspace:*",
    "@geo/insight-agent": "workspace:*",
    "@geo/metrics": "workspace:*",
    "@geo/shared": "workspace:*",
    "bullmq": "^5.28.0",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "playwright-core": "^1.48.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@types/pg": "^8.11.10"
  }
}
