{
  "name": "@geo/db",
  "version": "0.1.0",
  "description": "PostgreSQL schema(Drizzle)、分区维护与迁移器(docs/05 §5、docs/07 §8)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/cli.ts migrate",
    "partitions": "tsx src/cli.ts partitions"
  },
  "dependencies": {
    "@geo/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
