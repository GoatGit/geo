# 智能体登录技能配置模板:复制为 .env 后按需填写
# ── GEO 平台(必填)────────────────────────────────────────────
# 平台 API 地址
GEO_API_BASE=https://geo.gemux.cn
# 技能 API Key:管理后台 /admin/settings 全局配置「技能接口 API Key」自动生成
GEO_SKILL_API_KEY=
# 管理员手机号(可选;仅在开发环境未配置技能 Key 时显式填写,通过 devCode 取 token)
GEO_ADMIN_PHONE=

# ── AgentBay 远程浏览器(必填,与生产采集一致)──────────────────
BROWSER_MODE=agentbay
AGENTBAY_API_ENDPOINT=https://agentbay.cn-shanghai.aliyuncs.com
AGENTBAY_API_TOKEN=
AGENTBAY_IMAGE_ID=browser_latest
AGENTBAY_REGION_ID=cn-shanghai
# Context 持久化目录(沙箱内绝对路径,默认即为该值)
AGENTBAY_CONTEXT_PATH=/home/wuying/workspace
