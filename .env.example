# ===== 基础设施(dev 用 docker-compose.yml) =====
DATABASE_URL=postgres://geo:geo_dev@localhost:15432/geo
REDIS_URL=redis://localhost:16379

# ===== API =====
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
# console: 验证码直接返回/打印(dev);aliyun: 阿里云短信(生产,需签名/模板报备)
SMS_PROVIDER=console
# 平台管理员手机号(逗号分隔):登录时自动授予 admin 角色,可进 /admin 管理后台
ADMIN_PHONES=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ===== 证据存储(S3 兼容:本地 MinIO / 生产 OSS) =====
S3_ENDPOINT=http://localhost:19000
S3_REGION=cn-shanghai
S3_BUCKET=geo-evidence
S3_ACCESS_KEY_ID=geo
S3_SECRET_ACCESS_KEY=geo_dev_pass
S3_FORCE_PATH_STYLE=true
# dev:local | prod:s3
EVIDENCE_STORAGE=local
EVIDENCE_LOCAL_DIR=./infra/local-data/evidence
EVIDENCE_SIGNED_URL_TTL=900

# ===== 采集 =====
# mock: 回放 fixtures,dev/CI 全链路可跑 | agentbay: 无影 AgentBay 会话(需 Pro 权益包)
# local: 本机 Chrome 持久化 profile(自建降级路径,支持人工登录注入账号态)
BROWSER_MODE=mock
AGENTBAY_API_ENDPOINT=https://agentbay.cn-shanghai.aliyuncs.com
AGENTBAY_API_TOKEN=
AGENTBAY_IMAGE_ID=browser_latest
AGENTBAY_REGION_ID=cn-shanghai
# 本地浏览器代理(BROWSER_MODE=local 时生效)
LOCAL_BROWSER_PROFILE_DIR=./infra/local-data/browser-profiles
LOCAL_BROWSER_CHANNEL=chrome
# 1 = 采集也有头(调试用);默认仅人工登录时有头
LOCAL_BROWSER_HEADED=
LOCAL_BROWSER_IDLE_MS=120000
LOCAL_BROWSER_MAX_CONCURRENT=8
# 人工登录等待窗口(管理后台发起,worker 弹浏览器并轮询登录态)
LOGIN_TIMEOUT_MS=300000

# 每引擎并发与节流(令牌桶,见 docs/04 §5)
ENGINE_CONCURRENCY_DEFAULT=4
ENGINE_MAX_QPS_DEFAULT=1
ENGINE_DAILY_QUOTA_DEFAULT=20000
# 熔断:5 分钟失败率阈值(docs/04 §5:30%)
BREAKER_FAIL_RATE=0.3
BREAKER_WINDOW_MINUTES=5

# ===== 采集 Worker(apps/worker-web) =====
# 采集消费并发数(同时是调度器心跳上报值)
WORKER_CONCURRENCY=4
# 调度器扫描间隔(ms);每 tick 写心跳,管理后台据此判活
SCHEDULER_INTERVAL_MS=60000
# 单次 ask 超时(ms):挂死会话不占用并发槽,按 failed 进熔断/健康分
ASK_TIMEOUT_MS=120000
# 失败重试(docs/04 §5):1 次首发 + 重试,重试强制更换账号
COLLECT_ATTEMPTS=3
COLLECT_RETRY_BACKOFF_MS=3000

# ===== LLM 解析(生产接 DashScope,dev 用确定性基线) =====
LLM_PROVIDER=none
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash

# ===== 支付(微信支付 v3 Native / 支付宝预创建,docs/02 §7)=====
# 公网基址:渠道异步回调 notify_url = {PUBLIC_BASE_URL}/billing/notify/{wechat|alipay}
PUBLIC_BASE_URL=
# 微信支付(apiclient 密钥对 + 平台证书;任一缺失则该渠道在生产不可用,dev 自动降级 mock)
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_PLATFORM_CERT_PATH=
# 支付宝(应用私钥 PKCS8 + 支付宝公钥)
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
