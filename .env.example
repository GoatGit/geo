# ===== 基础设施(dev 用 docker-compose.yml) =====
DATABASE_URL=postgres://geo:geo_dev@localhost:15432/geo
REDIS_URL=redis://localhost:16379

# ===== API =====
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
# console: 验证码直接返回/打印(dev);aliyun: 阿里云短信(生产,需签名/模板报备)
SMS_PROVIDER=console
# 平台管理员手机号(逗号分隔):登录时自动授予 admin 角色,可进 /admin 管理后台
ADMIN_PHONES=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ===== 证据存储(S3 兼容:本地 MinIO / 生产 OSS) =====
S3_ENDPOINT=http://localhost:19000
S3_REGION=cn-shanghai
S3_BUCKET=geo-evidence
S3_ACCESS_KEY_ID=geo
S3_SECRET_ACCESS_KEY=geo_dev_pass
S3_FORCE_PATH_STYLE=true
# dev:local | prod:s3
EVIDENCE_STORAGE=local
EVIDENCE_LOCAL_DIR=./infra/local-data/evidence
EVIDENCE_SIGNED_URL_TTL=900

# ===== 采集 =====
# mock: 回放 fixtures,dev/CI 全链路可跑 | agentbay: 无影 AgentBay 会话(需 Pro 权益包)
BROWSER_MODE=mock
AGENTBAY_API_ENDPOINT=https://agentbay.cn-shanghai.aliyuncs.com
AGENTBAY_API_TOKEN=
AGENTBAY_IMAGE_ID=browser_latest
AGENTBAY_REGION_ID=cn-shanghai

# 每引擎并发与节流(令牌桶,见 docs/04 §5)
ENGINE_CONCURRENCY_DEFAULT=4
ENGINE_MAX_QPS_DEFAULT=1
ENGINE_DAILY_QUOTA_DEFAULT=20000
# 熔断:5 分钟失败率阈值(docs/04 §5:30%)
BREAKER_FAIL_RATE=0.3
BREAKER_WINDOW_MINUTES=5

# ===== 采集 Worker(apps/worker-web) =====
# 采集消费并发数(同时是调度器心跳上报值)
WORKER_CONCURRENCY=4
# 调度器扫描间隔(ms);每 tick 写心跳,管理后台据此判活
SCHEDULER_INTERVAL_MS=60000
# 单次 ask 超时(ms):挂死会话不占用并发槽,按 failed 进熔断/健康分
ASK_TIMEOUT_MS=120000
# 失败重试(docs/04 §5):1 次首发 + 重试,重试强制更换账号
COLLECT_ATTEMPTS=3
COLLECT_RETRY_BACKOFF_MS=3000

# ===== LLM 解析(生产接 DashScope,dev 用确定性基线) =====
LLM_PROVIDER=none
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
